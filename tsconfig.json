{
	"compilerOptions": {
		"baseUrl": ".",
		"allowJs": false,
		"checkJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"module": "nodenext",
		"paths": {
			"$lib": ["./src/frontend/src/lib"],
			"$lib/*": ["./src/frontend/src/lib/*"],
			"$declarations": ["./src/declarations"],
			"$declarations/*": ["./src/declarations/*"]
		}
	}
}
